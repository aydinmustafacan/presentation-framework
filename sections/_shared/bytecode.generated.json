  "Switches": {
   "source": "public class Switches {\n    static String dense(int day) {\n        switch (day) {\n            case 1: return \"Mon\";\n            case 2: return \"Tue\";\n            case 3: return \"Wed\";\n            case 4: return \"Thu\";\n            default: return \"?\";\n        }\n    }\n\n    static int sparse(int code) {\n        switch (code) {\n            case 200: return 0;\n            case 404: return 1;\n            case 5000: return 2;\n            default: return -1;\n        }\n    }\n}\n",
