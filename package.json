{
  "name": "presentation-framework",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Presentations where every section is a standalone single-file page.",
  "scripts": {
    "dev": "vite",
    "build": "tsx framework/build.ts",
    "preview": "vite preview --outDir dist/${DECK#decks/}",
    "new": "tsx framework/new-section.ts",
    "typecheck": "tsc --noEmit",
    "gen:bytecode": "node sections/_shared/java/generate.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
