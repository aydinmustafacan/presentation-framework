  "Sim": {
   "source": "public class Sim {\n    static int arith(int a, int b, int c) {\n        return (a + b) * c;\n    }\n\n    static int sum(int n) {\n        int s = 0;\n        for (int i = 1; i <= n; i++) {\n            s += i;\n        }\n        return s;\n    }\n\n    static int gcd(int a, int b) {\n        while (b != 0) {\n            int t = b;\n            b = a % b;\n            a = t;\n        }\n        return a;\n    }\n\n    static int fact(int n) {\n        if (n <= 1) return 1;\n        return n * fact(n - 1);\n    }\n\n    static int max(int a, int b) {\n        return a > b ? a : b;\n    }\n}\n",
